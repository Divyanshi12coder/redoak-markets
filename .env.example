# Copy to .env (docker compose) or backend/.env (local backend). Never commit real values.

# ---- Backend ----------------------------------------------------------------
ENVIRONMENT=development                 # development | production
DATABASE_URL=postgresql://redoak:redoak_dev_password@localhost:5432/redoak
JWT_SECRET=                             # required in production: openssl rand -hex 32
CORS_ORIGINS=http://localhost:5173      # comma-separated allowed browser origins

# Market data. "demo" = synthetic, clearly-labelled data (no key). "twelvedata" = real provider data.
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=                    # Twelve Data key (https://twelvedata.com), needed for MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_CREDITS_PER_MINUTE=8        # match your Twelve Data plan (free plan = 8)
MARKET_UNIVERSE=SPY,QQQ,DIA,IWM,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,JPM

# Optional: lets Dia rewrite its summary with an LLM (Anthropic Messages API). Backend works without it.
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# docker compose only
POSTGRES_PASSWORD=redoak_dev_password

# ---- Frontend (build time) ----------------------------------------------------
# Leave empty in local dev (Vite proxies /api). Set to the deployed API origin in production.
VITE_API_URL=
VITE_GITHUB_URL=https://github.com/Divyanshi12coder/red-oak-markets
